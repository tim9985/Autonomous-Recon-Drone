}
function showVision(v, rid) {
  if (!v) { $('vision-status').textContent = '이전 실행은 비행만 포함합니다. 새 정찰부터 사진 분석을 함께 실행합니다.'; return; }
  $('vision-status').textContent = `서버 사진 ${v.frames}장 · 분석 완료 ${v.analysis_completed || 0} / ${v.frames} · 실패 ${v.analysis_failed || 0}\n후보 ${v.candidates}개 · 관측 ${v.observations}건`;
  $('candidates').textContent = v.items.slice(0, 5).map(c => `${c.candidate_id.slice(0,8)} · ${c.evidence_count}회 · ${c.geo_status}`).join('\n');
  if (!v.frame) { $('frame').hidden = true; $('boxes').replaceChildren(); displayedFrame = undefined; return; }
  const key = rid + '/' + v.frame.frame_id;
  if (displayedFrame !== key) {
    $('frame').src = `/api/v1/simulations/patrols/${rid}/frames/${v.frame.frame_id}/image`;
    $('frame').hidden = false; displayedFrame = key;
  }
  $('boxes').replaceChildren();
  for (const box of v.boxes) {
    const {x1:x, y1:y, x2, y2} = box.bbox;
    const el = document.createElement('span'); el.className = 'detection';
    Object.assign(el.style, { left: `${100*x/v.frame.width}%`, top: `${100*y/v.frame.height}%`, width: `${100*(x2-x)/v.frame.width}%`, height: `${100*(y2-y)/v.frame.height}%` });
    el.title = `${box.candidate_id} · ${(box.confidence*100).toFixed(0)}% · ${box.geo_status}`;
    $('boxes').append(el);
  }
}
initialize().catch(error => message(error.message + '\n관제 첫 화면에서 test 계정으로 로그인하세요.'));

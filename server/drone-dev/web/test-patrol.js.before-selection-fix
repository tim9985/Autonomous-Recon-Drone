'use strict';
const $ = id => document.getElementById(id);
const terminal = new Set(['COMPLETED', 'CANCELLED', 'FAILED']);
const labels = { QUEUED: '연결기 처리 대기', RUNNING: 'Unreal 실행 중', COMPLETED: '정찰·귀환·착륙 완료', CANCELLED: '중지 완료', FAILED: '실행 실패 — 기록 확인' };
